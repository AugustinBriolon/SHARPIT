{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "public/sw.js", "public/sw.js.map"]
    },
    "test": { "cache": false },
    "typecheck": { "cache": false },
    "lint": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
