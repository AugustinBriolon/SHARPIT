# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database (Postgres, Prisma 6) ---
DATABASE_URL="postgresql://user:password@localhost:5432/sharpit"
# Set to "true" only when running behind Neon's serverless driver adapter.
PRISMA_NEON_ADAPTER=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- AI coach ---
AI_GATEWAY_API_KEY=
COACH_MODEL=
FEATURE_ENGINE_ENABLED=

# --- Secrets / crypto ---
# Required in production to encrypt stored provider tokens (src/lib/secret-box.ts).
# Falls back to CRON_SECRET/DATABASE_URL in local dev only — never in production.
SECRET_ENCRYPTION_KEY=

# --- Cron (Vercel Scheduled Functions) ---
# Long random value; every src/app/api/cron/*/route.ts request must present
# `Authorization: Bearer $CRON_SECRET`. Requests are rejected if this is unset.
CRON_SECRET=

# --- Rate limiting (Upstash Redis) ---
# Required in production for coach / sync / AI routes (those fail closed if unset).
# The global apiGeneral flood backstop still fails open so a Redis blip cannot
# take the whole app down. Set both URL and TOKEN (already used in Vercel prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Private-circle signup gate (V0 trust) ---
# Defense in depth alongside Clerk Dashboard Allowlist / Invitations.
# Enable with SIGNUP_GATE_ENABLED=true, or implicitly by setting either list.
# Existing AthleteProfile rows are never blocked — only brand-new provisioning.
# When enabled with empty lists, all new signups are rejected (fail-closed).
SIGNUP_GATE_ENABLED=false
# Comma-separated emails allowed to create a new account.
SIGNUP_ALLOWED_EMAILS=
# Comma-separated invite codes; redeem via /sign-up form or /api/invite/redeem?code=
SIGNUP_INVITE_CODES=

# --- Admin ---
# Comma-separated list of Clerk account emails allowed on /admin and /api/admin/*
# and the /api/dev/* developer tools.
ADMIN_EMAILS=

# --- Dev-only ---
DEV_TOOLS_ENABLED=false
DEV_BYPASS_CLERK=false
NEXT_PUBLIC_DEV_BYPASS_CLERK=false
DEV_LAN_HOST=

# --- Provider OAuth integrations ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Misc ---
SHARPIT_DEFAULT_LATITUDE=
SHARPIT_DEFAULT_LONGITUDE=
TZ=
