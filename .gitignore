# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# Yarn is the package manager (see package.json#packageManager) — ignore other lockfiles
/package-lock.json
/pnpm-lock.yaml

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache
/e2e/.auth

# next.js / production output
/.next/
/out/
/build

# misc
.DS_Store
*.pem
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit only .env.example)
.env*
!.env.example

# vercel
.vercel

# typescript (generated)
*.tsbuildinfo
next-env.d.ts

# serwist (generated from src/sw.ts at build)
/public/sw.js
/public/sw.js.map

# clerk (can include secrets)
/.clerk/

# local agent / critique tooling (not part of the app)
/.agents/
/.claude/
/.codex/
/.hallmark/
/.impeccable/
/.superpowers/
/.uizze/

# local one-off TypeScript scripts
/scripts/tmp-*.ts
/scripts/tmp-*.mts

# Local Garmin DI mint (python-garminconnect) — never commit
garmin_tokens.json
